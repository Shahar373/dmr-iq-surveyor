# Configuration for the dmr-iq-surveyor field service.
#
# Copy to /etc/dmr-field/field.env and edit. scripts/install_field_service.sh
# does that for you and fills in the paths it was given.
#
#   sudo install -m 0644 deploy/field.env.example /etc/dmr-field/field.env
#
# This file is read by systemd's EnvironmentFile= and parsed -- not sourced --
# by scripts/fieldctl. That means shell rules do NOT apply: there is no
# expansion, no command substitution and no quoting -- `FIELD_BAND=a b` sets
# the value to exactly `a b`, quotes would become part of the value, and a
# `#` only starts a comment at the beginning of a line.
#
# NO SECRET BELONGS IN THIS FILE. The token is named by path, never by value
# (see FIELD_TOKEN_FILE). Anything set here is visible to `systemctl show`.
#
# Local overrides that should survive an update go in
# /etc/dmr-field/field.env.local, which the unit reads afterwards if present
# and which therefore WINS over anything set here. `fieldctl` reads the same
# two files in the same order, so `fieldctl status` and
# `fieldctl print-command` report the configuration the service is actually
# running with; `fieldctl status` names which of the two files each value
# came from. An empty assignment in the local file (`FIELD_CAMPAIGN=`) clears
# a value set here rather than falling back to it.

# --- what to run -------------------------------------------------------

# The dmr-surveyor entry point inside the deployment's own virtualenv. That
# venv must be able to `import SoapySDR`; a freshly created one cannot, until
# scripts/pi_soapysdr_setup.sh has linked the system bindings into it.
FIELD_SURVEYOR_BIN=/opt/dmr-field/venv/bin/dmr-surveyor

# --- where to listen ---------------------------------------------------

# Leave EMPTY to bind the Pi's Tailscale IPv4 address, resolved at start
# time. That is the intended deployment: the app is reachable over the
# tailnet and from nowhere else.
#
# Set it to bind something specific instead -- 127.0.0.1 for a local-only
# test, or a hotspot address when there is no tailnet. 0.0.0.0 is accepted
# but binds every interface, including any untrusted network the Pi is on,
# and the API can start a capture; it is never a default and never a
# fallback.
FIELD_HOST=
FIELD_PORT=8765

# --- what to survey ----------------------------------------------------

# ABSOLUTE path to the site profile for this campaign. Required: there is no
# default, because the profile records the antenna, receiver and fixed gain
# for a specific deployment and guessing one silently would record every stop
# against the wrong equipment context. It is kept outside the checkout so
# that a real profile never lands in git; the installer takes it as an
# argument. The file name is whatever the campaign uses -- e.g.
# /etc/dmr-field/sites/field.yaml
FIELD_SITE=

# Band profile, by name (resolved under config/bands/ in the checkout) or as
# an absolute path. A campaign-specific profile belongs outside the checkout,
# named here by absolute path, the same way FIELD_SITE is.
FIELD_BAND=central_800_narrow

# --- project and collection round --------------------------------------

# Both are OPTIONAL and both ship empty. Empty means the flag is not passed
# at all, and the app behaves exactly as it did before projects existed --
# which is what every install made before this keeps doing without being
# touched.
#
# FIELD_PROJECT is a project manifest: an absolute path to a project.yaml, or
# a name resolved as config/projects/<name>/project.yaml in the checkout. It
# binds the service to ONE database -- the one the manifest names, which must
# already exist and already carry that project's claim -- and the process
# will open no other. A missing, empty, unclaimed or foreign database fails
# at startup rather than being created.
#
# Setting it makes the manifest a second source for the band, the site and
# the output root. An explicit setting here that CONTRADICTS the manifest's
# band is refused and the service will not start: levels recorded under
# different bands are not comparable, so this fails loudly rather than
# picking one. Site and output simply win from here. Check with
# `fieldctl print-command` before restarting.
FIELD_PROJECT=

# FIELD_CAMPAIGN is the collection round every stop is recorded under, e.g.
# 2026-09_day1. Lower case, digits, '.', '_' and '-'. It selects
# <project root>/campaigns/<id>.yaml, which must already exist.
#
# Set on its own, without FIELD_PROJECT, it still TAGS every stop: the id
# reaches survey_runs.campaign_id either way. What it does not get is the
# manifest -- the band, site, hardware and capture settings the round is
# pinned to -- and the `fieldctl campaign` commands, which manage campaigns
# through that manifest, need a project. `fieldctl status` says so.
#
# `fieldctl campaign use` is the safe way to change this on a running
# deployment: it writes to field.env.local, leaves this file alone, refuses
# while a job is running, and rolls back if the service does not come up on
# the campaign that was asked for.
FIELD_CAMPAIGN=

# --- what to capture ---------------------------------------------------

# These are passed explicitly on every start, never left to the CLI's own
# defaults. The service is not attended while it starts: an implicit default
# is one nobody reads, and the pairing below is the one that has actually
# failed in the field -- 5 MS/s for 90 s is 1.68 GiB per stop, and storage
# that cannot sustain the write rate loses samples rather than refusing.
#
# The values here are the CLI's documented defaults, so installing without
# choosing changes nothing. Choose deliberately instead: run
#
#   dmr-surveyor survey preflight <recordings dir> --band <band> \
#     --sample-rate <rate> --duration <seconds>
#
# which measures the real write throughput of this storage and reports the
# highest sample rate it can sustain. Pass the result to the installer with
# --sample-rate / --duration / --center-frequency; `fieldctl status` and
# `fieldctl print-command` both show what is in effect.

FIELD_CENTER_FREQUENCY=867406250
FIELD_SAMPLE_RATE=5000000
FIELD_DURATION=90

# SoapySDR driver name.
FIELD_DRIVER=sdrplay

# Grid resolution in metres for the in-field solve after each capture.
# Coarser than `geo solve`'s default because a full-resolution pass over a
# few dozen sites takes minutes on a Pi.
FIELD_SOLVE_RESOLUTION_M=250

# IF gain reduction and LNA state are deliberately NOT here. They come from
# the site profile named by FIELD_SITE, which is the one file the field guide
# tells an operator to fill in, and the app prints at startup which source it
# used. A second place to set them would be a second thing to keep in step,
# and a gain that silently differs between stops is exactly what the
# campaign's own gain-discipline checks exist to catch after the fact.

# --- where output goes -------------------------------------------------

FIELD_OUTPUT=/var/lib/dmr-field
FIELD_DATABASE=/var/lib/dmr-field/inventory/dmr_inventory.sqlite3

# How many captured recordings to keep. Each 5 MS/s 90 s stop is about
# 1.68 GiB, so a campaign cannot keep them all.
FIELD_KEEP_RECORDINGS=1

# --- credentials and TLS -----------------------------------------------

# Path to the file holding the shared API token -- never the token itself.
# The file must be readable by its owner only (chmod 600) and must not be
# empty; the app refuses to start otherwise, because an empty token would
# authorise every request. The installer generates it once and never
# rewrites it, which is what lets a phone bookmark survive a reboot.
FIELD_TOKEN_FILE=/etc/dmr-field/token

# A certificate and key issued once, at install time, and then left alone.
# They are pinned rather than regenerated on demand: the self-signing helper
# folds the machine's current default-route address into the names it wants,
# so a Pi that changes networks would be issued a fresh certificate with a
# fresh fingerprint, and every phone that had accepted the old one would be
# sent back to the browser's warning page.
FIELD_TLS_CERT=/var/lib/dmr-field/tls/field-app.crt
FIELD_TLS_KEY=/var/lib/dmr-field/tls/field-app.key

# --- Tailscale ---------------------------------------------------------

FIELD_TAILSCALE_BIN=tailscale

# How long `fieldctl wait-network` waits for a Tailscale address before
# giving up and letting systemd retry. Raising it lengthens the retry cycle;
# keep StartLimitIntervalSec in the unit shorter than
# StartLimitBurst * (this + RestartSec) or a slow tailnet will eventually
# park the service in start-limit-hit instead of continuing to retry.
FIELD_TAILSCALE_WAIT=90

# Skip the lookup and use this address. Intended for tests and for
# reproducing a start by hand; leave it unset in a real install.
#FIELD_TAILSCALE_IP=
