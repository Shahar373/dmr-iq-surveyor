# Configuration for the dmr-iq-surveyor field service.
#
# Copy to /etc/dmr-field/field.env and edit. scripts/install_field_service.sh
# does that for you and fills in the paths it was given.
#
#   sudo install -m 0644 deploy/field.env.example /etc/dmr-field/field.env
#
# This file is read by systemd's EnvironmentFile= and sourced by
# scripts/fieldctl. That means shell rules do NOT apply: there is no
# expansion, no command substitution and no quoting -- `FIELD_BAND=a b` sets
# the value to exactly `a b`, quotes would become part of the value, and a
# `#` only starts a comment at the beginning of a line.
#
# NO SECRET BELONGS IN THIS FILE. The token is named by path, never by value
# (see FIELD_TOKEN_FILE). Anything set here is visible to `systemctl show`.
#
# Local overrides that should survive an update go in
# /etc/dmr-field/field.env.local, which the unit reads afterwards if present.

# --- what to run -------------------------------------------------------

# The dmr-surveyor entry point inside the deployment's own virtualenv. That
# venv must be able to `import SoapySDR`; a freshly created one cannot, until
# scripts/pi_soapysdr_setup.sh has linked the system bindings into it.
FIELD_SURVEYOR_BIN=/opt/dmr-field/venv/bin/dmr-surveyor

# --- where to listen ---------------------------------------------------

# Leave EMPTY to bind the Pi's Tailscale IPv4 address, resolved at start
# time. That is the intended deployment: the app is reachable over the
# tailnet and from nowhere else.
#
# Set it to bind something specific instead -- 127.0.0.1 for a local-only
# test, or a hotspot address when there is no tailnet. 0.0.0.0 is accepted
# but binds every interface, including any untrusted network the Pi is on,
# and the API can start a capture; it is never a default and never a
# fallback.
FIELD_HOST=
FIELD_PORT=8765

# --- what to survey ----------------------------------------------------

# ABSOLUTE path to the site profile for this campaign. Required: there is no
# default, because the profile records the antenna, receiver and fixed gain
# for a specific deployment and guessing one silently would record every stop
# against the wrong equipment context. It is kept outside the checkout so
# that a real profile never lands in git; the installer takes it as an
# argument. The file name is whatever the campaign uses -- e.g.
# /etc/dmr-field/sites/g4_field.yaml
FIELD_SITE=

# Band profile, by name (resolved under config/bands/ in the checkout) or as
# an absolute path.
FIELD_BAND=central_800_narrow

# --- where output goes -------------------------------------------------

FIELD_OUTPUT=/var/lib/dmr-field
FIELD_DATABASE=/var/lib/dmr-field/inventory/dmr_inventory.sqlite3

# How many captured recordings to keep. Each 5 MS/s 90 s stop is about
# 1.68 GiB, so a campaign cannot keep them all.
FIELD_KEEP_RECORDINGS=1

# --- credentials and TLS -----------------------------------------------

# Path to the file holding the shared API token -- never the token itself.
# The file must be readable by its owner only (chmod 600) and must not be
# empty; the app refuses to start otherwise, because an empty token would
# authorise every request. The installer generates it once and never
# rewrites it, which is what lets a phone bookmark survive a reboot.
FIELD_TOKEN_FILE=/etc/dmr-field/token

# A certificate and key issued once, at install time, and then left alone.
# They are pinned rather than regenerated on demand: the self-signing helper
# folds the machine's current default-route address into the names it wants,
# so a Pi that changes networks would be issued a fresh certificate with a
# fresh fingerprint, and every phone that had accepted the old one would be
# sent back to the browser's warning page.
FIELD_TLS_CERT=/var/lib/dmr-field/tls/field-app.crt
FIELD_TLS_KEY=/var/lib/dmr-field/tls/field-app.key

# --- Tailscale ---------------------------------------------------------

FIELD_TAILSCALE_BIN=tailscale

# How long `fieldctl wait-network` waits for a Tailscale address before
# giving up and letting systemd retry. Raising it lengthens the retry cycle;
# keep StartLimitIntervalSec in the unit shorter than
# StartLimitBurst * (this + RestartSec) or a slow tailnet will eventually
# park the service in start-limit-hit instead of continuing to retry.
FIELD_TAILSCALE_WAIT=90

# Skip the lookup and use this address. Intended for tests and for
# reproducing a start by hand; leave it unset in a real install.
#FIELD_TAILSCALE_IP=
